{"kind": "query", "run_id": "3baded45e4944e1389f5b3130499e4ff", "recorded_at_utc": "2026-11-09T14:29:09.599622Z", "timeframe": "2026-04-01 to 2026-10-01 UTC (complete months)", "purpose": "Evaluator oracle o27_episode_rankings", "limitations": ["evaluator-only; keep out of agent context"], "hypothesis_status": "not assessed", "parameters_recorded": true, "result_recorded": true, "parameters": {"coverage_start": "2026-04-01T00:00:00Z", "coverage_end": "2026-10-01T00:00:00Z"}, "query_evidence": {"question": "ORACLE B3 for scenarios Q12", "sql": "WITH comp AS (WITH user_episodes AS (\nSELECT v.user_id, v.content_id, v.episode_number, MIN(v.view_started_at) AS first_start_at,\n       strftime('%Y-%m-%dT%H:%M:%SZ', MIN(v.view_started_at), '+7 days') AS window_end_at\nFROM content_views v\nGROUP BY v.user_id, v.content_id, v.episode_number\n),\nsegments AS (\n  SELECT e.user_id, e.content_id, e.episode_number, s.position_start_sec AS a, s.position_end_sec AS b\n  FROM user_episodes e\n  JOIN content_views v ON v.user_id = e.user_id AND v.content_id = e.content_id\n                      AND v.episode_number = e.episode_number\n                      AND v.view_started_at < e.window_end_at\n  JOIN playback_segments s ON s.view_id = v.view_id\n  WHERE s.position_end_sec > s.position_start_sec\n),\nordered AS (\n  SELECT *, MAX(b) OVER (PARTITION BY user_id, content_id, episode_number ORDER BY a, b\n                         ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS prior_end\n  FROM segments\n),\nislands AS (\n  SELECT *, SUM(CASE WHEN prior_end IS NULL OR a > prior_end THEN 1 ELSE 0 END)\n              OVER (PARTITION BY user_id, content_id, episode_number ORDER BY a, b\n                    ROWS UNBOUNDED PRECEDING) AS island\n  FROM ordered\n),\ncoverage AS (\n  SELECT user_id, content_id, episode_number, SUM(island_sec) AS covered_sec\n  FROM (SELECT user_id, content_id, episode_number, MAX(b) - MIN(a) AS island_sec\n        FROM islands GROUP BY user_id, content_id, episode_number, island)\n  GROUP BY user_id, content_id, episode_number\n)\nSELECT e.user_id, e.content_id, e.episode_number, e.first_start_at, e.window_end_at,\n       COALESCE(c.covered_sec, 0) AS covered_sec, d.episode_duration_sec,\n       COALESCE(c.covered_sec, 0) >= 0.9 * d.episode_duration_sec AS completed\nFROM user_episodes e\nJOIN content_episodes d ON d.content_id = e.content_id AND d.episode_number = e.episode_number\nLEFT JOIN coverage c ON c.user_id = e.user_id AND c.content_id = e.content_id AND c.episode_number = e.episode_number),\nv AS (SELECT view_id, user_id, content_id, episode_number FROM content_views\n      WHERE view_started_at >= :coverage_start AND view_started_at < :coverage_end),\nseg AS (SELECT s.view_id, SUM(s.watch_duration_sec) ws FROM playback_segments s JOIN v ON v.view_id = s.view_id GROUP BY s.view_id),\npe AS (SELECT v.content_id, v.episode_number, count(*) views, count(DISTINCT v.user_id) viewers, round(sum(coalesce(seg.ws,0))/3600.0, 2) watch_hours\n       FROM v LEFT JOIN seg ON seg.view_id = v.view_id GROUP BY 1,2),\npc AS (SELECT content_id, episode_number, count(*) eligible_user_episodes, sum(completed) completed\n       FROM comp WHERE first_start_at >= :coverage_start AND window_end_at <= :coverage_end GROUP BY 1,2)\nSELECT pe.content_id, pe.episode_number, d.access_tier, pe.views, pe.viewers, pe.watch_hours,\n       pc.eligible_user_episodes, pc.completed, round(1.0*pc.completed/pc.eligible_user_episodes, 4) completion_rate,\n       (SELECT count(*) FROM pe p2 WHERE p2.views > pe.views) + 1 AS rank_views,\n       (SELECT count(*) FROM pe p2 WHERE p2.viewers > pe.viewers) + 1 AS rank_viewers,\n       (SELECT count(*) FROM pe p2 WHERE p2.watch_hours > pe.watch_hours) + 1 AS rank_watch_hours\nFROM pe LEFT JOIN pc ON pc.content_id = pe.content_id AND pc.episode_number = pe.episode_number\nLEFT JOIN content_episodes d ON d.content_id = pe.content_id AND d.episode_number = pe.episode_number\nORDER BY pe.views DESC", "source_layer": "source tables (oracle; no Silver/Gold)", "metric_version": "ad hoc on engagement 1.0 building blocks (views, viewers, watch time, user_episode_completion)", "snapshot_id": "file sha256 8d39e78bbaa756b594c9e38797490dc1879f2980a05f966aaf62d3919517790b; build 3a0dbed21d2f45958aefa2887a0cadd8", "database_name": "pockettoons.sqlite", "max_rows": 500, "timeout_seconds": 60, "sql_sha256": "2e9c9302979124f8eb589fcce599645be3fd6672b657e132cdb8fa478b67f493", "parameters_included": false, "status": "ok", "returned_rows": 241, "truncated": false, "duration_ms": 1291.199}, "result": {"columns": ["content_id", "episode_number", "access_tier", "views", "viewers", "watch_hours", "eligible_user_episodes", "completed", "completion_rate", "rank_views", "rank_viewers", "rank_watch_hours"], "rows": [["c01", 3, "free", 8014, 3738, 1041.8, 3571, 1012, 0.2834, 1, 1, 4], ["c01", 4, "free", 7940, 3606, 1059.37, 3390, 994, 0.2932, 2, 3, 3], ["c01", 2, "free", 7386, 3683, 1104.21, 3492, 1050, 0.3007, 3, 2, 1], ["c01", 5, "free", 7344, 3226, 1028.35, 3035, 897, 0.2956, 4, 6, 5], ["c01", 6, "free", 7037, 3280, 1061.37, 3072, 908, 0.2956, 5, 4, 2], ["c01", 7, "free", 6770, 3022, 932.63, 2853, 853, 0.299, 6, 10, 7], ["c01", 1, "free", 6607, 3275, 846.98, 3106, 925, 0.2978, 7, 5, 10], ["c01", 8, "free", 6561, 3147, 868.17, 2916, 829, 0.2843, 8, 7, 9], ["c01", 9, "free", 6298, 2927, 814.01, 2747, 798, 0.2905, 9, 11, 12], ["c01", 10, "free", 6280, 3067, 891.05, 2839, 847, 0.2983, 10, 9, 8], ["c01", 12, "free", 6233, 3069, 823.83, 2846, 852, 0.2994, 11, 8, 11], ["c01", 11, "free", 6195, 2899, 956.65, 2717, 838, 0.3084, 12, 12, 6], ["c05", 7, "free", 2005, 901, 281.77, 901, 267, 0.2963, 13, 28, 25], ["c09", 11, "free", 1968, 930, 314.11, 930, 278, 0.2989, 14, 26, 15], ["c10", 3, "free", 1961, 1099, 311.48, 1029, 361, 0.3508, 15, 15, 17], ["c11", 1, "free", 1943, 889, 264.53, 889, 277, 0.3116, 16, 35, 29], ["c09", 12, "free", 1927, 828, 262.88, 828, 233, 0.2814, 17, 38, 31], ["c07", 10, "f